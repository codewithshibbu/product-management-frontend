# Product Management Frontend — environment variables
#
# Setup:
#   1. Copy this file:  cp .env.example .env
#   2. Edit .env and set VITE_API_URL to your Laravel API base URL
#   3. Run: npm install && npm run dev
#
# Notes:
#   - Only variables starting with VITE_ are visible in the Vue app
#   - URL must end with /api (e.g. http://127.0.0.1:8000/api)
#   - Use the same host as the backend (127.0.0.1 vs localhost) for images to load
#   - Restart `npm run dev` after changing .env

# Laravel API base URL (required)
VITE_API_URL=http://127.0.0.1:8000/api
